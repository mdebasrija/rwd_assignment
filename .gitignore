# patient level data should never be committed, except checksums which may be useful to check integrity
data/* 
!data/CHECKSUMS.sha256 
!data/.gitkeep

# should rebuild through scripts, the ones kept are according to the brief
output/* 
!output/.gitkeep
!output/report.html
!output/figures/
!output/logs/
output/logs/sessionInfo.txt

# RStudio data, not needed
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.positai

# Supplied assignment brief (not my work so keeping private)
Assignment_and_Data_Guide.pdf
